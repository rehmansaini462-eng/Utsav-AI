# ==============================================================================
# Utsav AI - Environment Configuration Example
# Copy this file to .env.local: `cp .env.example .env.local`
# DO NOT commit real API keys or secrets to version control.
# ==============================================================================

# Google Gemini AI API Key
# Required for strictly dynamic celebration planning and recommendations.
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Upstash Redis REST Credentials
# Distributed rate limiting (sliding window 10 req / 60s) for serverless scalability.
# Get yours at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Optional Runtime Flags
# SKIP_ENV_VALIDATION=false
